# ==============================================================================
# LQMTM - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Lo Que Mastica Tu Mascota - Funnel de Adquisición y Meta Pixel
# ==============================================================================

# --- VARIABLES PÚBLICAS (CLIENTE / BROWSER) ---
# En Next.js usan el prefijo NEXT_PUBLIC_ y en Vite usan VITE_
# IMPORTANTE: Nunca colocar tokens privados o secretos en estas variables.

# ID oficial del Meta Pixel provisto por Meta Events Manager (ej. "123456789012345")
NEXT_PUBLIC_META_PIXEL_ID="MY_META_PIXEL_ID"
VITE_META_PIXEL_ID="MY_META_PIXEL_ID"

# ID de medición de Google Analytics 4 opcional (ej. "G-XXXXXXXXXX")
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
VITE_GA_MEASUREMENT_ID=""

# Número oficial de WhatsApp comercial de LQMTM para recepción de consultas (formato internacional)
NEXT_PUBLIC_WHATSAPP_NUMBER="+5491136458899"
VITE_WHATSAPP_NUMBER="+5491136458899"

# URLs oficiales de la marca
NEXT_PUBLIC_SITE_URL="https://loquemasticatumascota.com.ar"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/loquemasticatumascota/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/loquemasticatumascota/"

# URLs de bases legales y privacidad
NEXT_PUBLIC_TERMS_URL="https://loquemasticatumascota.com.ar/bases-sorteo"
NEXT_PUBLIC_PRIVACY_URL="https://loquemasticatumascota.com.ar/privacidad"

# --- VARIABLES PRIVADAS (SOLO SERVIDOR) ---
# NUNCA compartir ni exponer en el frontend.

# Credenciales de administración para el Panel de Métricas (requeridas para iniciar sesión)
ADMIN_EMAIL="admin@loquemasticatumascota.com.ar"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_64_CHAR_HEX_SECRET"

# Salt criptográfico para anonimización de direcciones IP (SHA-256)
IP_HASH_SALT="CHANGE_ME_RANDOM_SALT"

# Opcional: Integración con Supabase Auth y Base de Datos
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Cadena de conexión para PostgreSQL en producción (Vercel Postgres, Supabase, Neon o Cloud SQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/lqmtm_db?sslmode=prefer"

# Token de Meta Conversions API (CAPI) para deduplicación server-side (Opcional)
META_CONVERSIONS_API_ACCESS_TOKEN=""

# Puerto de ejecución del servidor local / contenedor
PORT="3000"

